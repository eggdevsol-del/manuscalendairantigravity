@@ -0,0 +1,974 @@
+/* Ivory: the shared Tattoi presentation layer. Domain and payment state stay in pages. */
+:root {
+  --ivory-display:
+    ui-serif, "Iowan Old Style", "Palatino Linotype", Georgia, serif;
+  --ivory-body:
+    -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
+  --ivory-warning: #855318;
+  --ivory-warning-bg: #f8eedc;
+  --ivory-shadow: 0 8px 28px rgb(56 44 36 / 5%);
+  --v3-radius: 22px;
+  --v3-gutter: 20px;
+  --color-primary: var(--primary);
+}
+.dark {
+  --ivory-warning: #e8c38c;
+  --ivory-warning-bg: #3a3021;
+  --ivory-shadow: 0 8px 28px rgb(0 0 0 / 12%);
+}
+body {
+  font-family: var(--ivory-body);
+  -webkit-font-smoothing: antialiased;
+}
+.v3-screen {
+  font-family: var(--ivory-body);
+  font-size: 17px;
+  line-height: 1.45;
+}
+.v3-header {
+  padding: 10px var(--v3-gutter) 22px;
+}
+.v3-masthead {
+  margin-bottom: 14px;
+}
+.v3-wordmark {
+  font: 32px/1 var(--ivory-display);
+  letter-spacing: -0.055em;
+  text-transform: none;
+}
+.v3-header h1 {
+  font-family: var(--ivory-display);
+  font-weight: 500;
+  font-size: 36px;
+  line-height: 1.1;
+  letter-spacing: -0.045em;
+}
+.v3-subtitle {
+  font-size: 15px;
+  line-height: 1.45;
+  margin-top: 8px;
+  max-width: 44ch;
+}
+.v3-content {
+  gap: 24px;
+  padding-bottom: 28px;
+}
+.v3-scroll {
+  scrollbar-width: thin;
+  scrollbar-color: var(--v3-line) transparent;
+}
+.v3-action {
+  border-radius: 16px;
+  min-height: 50px;
+  font-size: 16px;
+  font-weight: 550;
+  padding: 13px 18px;
+  transition:
+    background-color 0.15s,
+    transform 0.15s;
+}
+.v3-action-primary {
+  background: var(--primary);
+  color: var(--primary-foreground);
+  box-shadow: 0 2px 3px rgb(56 44 36 / 5%);
+}
+.v3-action-secondary {
+  background: var(--v3-soft);
+  border-color: transparent;
+}
+.v3-action-quiet {
+  box-shadow: none;
+}
+.v3-action:not(:disabled):active {
+  transform: scale(0.985);
+}
+.v3-icon-button {
+  border-radius: 50%;
+  background: var(--v3-soft);
+}
+.v3-section-heading {
+  margin: 0 2px 12px;
+}
+.v3-section-heading h2 {
+  font: 550 15px/1.35 var(--ivory-body);
+  text-transform: none;
+  letter-spacing: 0;
+  color: var(--v3-muted);
+}
+.v3-panel {
+  border-color: color-mix(in srgb, var(--v3-line) 60%, transparent);
+  box-shadow: var(--ivory-shadow);
+  padding: 20px;
+}
+.v3-panel h2,
+.v3-panel h3 {
+  font-weight: 550;
+  letter-spacing: -0.025em;
+}
+.v3-panel-attention {
+  background: var(--v3-gold-soft);
+}
+.v3-row {
+  padding: 16px 4px;
+  gap: 12px;
+  min-height: 68px;
+  font-size: 16px;
+}
+.v3-row-copy strong {
+  font-weight: 550;
+  line-height: 1.35;
+}
+.v3-row-copy > span {
+  font-size: 14px;
+  line-height: 1.45;
+  margin-top: 4px;
+}
+.v3-row-icon {
+  color: var(--v3-gold-ink);
+}
+.v3-section > .v3-row {
+  background: var(--v3-surface);
+  padding-inline: 16px;
+  border-color: var(--v3-line);
+}
+.v3-section > .v3-section-heading + .v3-row {
+  border-radius: 20px 20px 0 0;
+}
+.v3-section > .v3-row:last-child {
+  border-bottom: 0;
+  border-radius: 0 0 20px 20px;
+}
+.v3-section > .v3-section-heading + .v3-row:last-child {
+  border-radius: 20px;
+}
+.v3-avatar {
+  background: var(--v3-soft);
+  box-shadow: inset 0 0 0 1px var(--v3-line);
+  color: var(--v3-gold-ink);
+}
+.v3-status {
+  border-radius: 99px;
+  font-size: 12px;
+  line-height: 1.4;
+  padding: 6px 10px;
+}
+.v3-status[data-tone="warning"] {
+  color: var(--ivory-warning);
+  background: var(--ivory-warning-bg);
+}
+.v3-search {
+  background: var(--v3-soft);
+  border-color: transparent;
+  border-radius: 14px;
+}
+.v3-search input {
+  font-size: 17px;
+}
+.v3-tabs {
+  gap: 3px;
+  background: var(--v3-soft);
+  border: 0;
+  border-radius: 14px;
+  padding: 4px;
+}
+.v3-tabs button {
+  flex: 1 0 auto;
+  min-height: 44px;
+  padding: 9px 12px;
+  border: 0;
+  border-radius: 11px;
+  font-size: 14px;
+}
+.v3-tabs button[aria-selected="true"] {
+  background: var(--v3-surface);
+  box-shadow: 0 1px 5px rgb(56 44 36 / 9%);
+}
+.v3-form {
+  gap: 22px;
+}
+.v3-form label {
+  font-size: 15px;
+  font-weight: 500;
+}
+.v3-form input,
+.v3-form select,
+.v3-form textarea {
+  border-radius: 14px;
+  font-size: 17px;
+  padding: 13px 14px;
+  border-color: var(--v3-line);
+}
+.v3-form input:focus-visible,
+.v3-form select:focus-visible,
+.v3-form textarea:focus-visible {
+  outline: 2px solid var(--ring);
+  outline-offset: 3px;
+}
+.v3-form input[type="checkbox"],
+.v3-form input[type="radio"] {
+  accent-color: var(--primary);
+}
+.v3-form small {
+  font-size: 13px;
+  line-height: 1.45;
+}
+.v3-feedback {
+  border-radius: 20px;
+  padding: 24px;
+  background: var(--v3-soft);
+}
+.v3-feedback[role="alert"] {
+  border-left: 3px solid var(--v3-red);
+}
+.v3-feedback h2 {
+  font-family: var(--ivory-display);
+  font-weight: 500;
+  font-size: 25px;
+  margin-bottom: 8px;
+}
+.v3-choice {
+  border-radius: 18px;
+}
+.v3-choice[aria-pressed="true"] {
+  background: var(--v3-gold-soft);
+  border-color: var(--v3-gold-ink);
+}
+.v3-facts {
+  font-size: 15px;
+}
+.v3-facts > div {
+  padding: 15px 0;
+}
+.v3-price {
+  font: 40px/1.15 var(--ivory-display);
+  font-variant-numeric: tabular-nums;
+}
+/* A quiet next appointment leads the working day. Expand the task queue when needed. */
+.v3-home-main > .v3-stack {
+  order: -1;
+}
+.v3-home-tabs {
+  display: flex;
+  gap: 4px;
+  background: var(--v3-soft);
+  padding: 4px;
+  border-radius: 14px;
+}
+.v3-home-tabs a {
+  flex: 1;
+  min-width: 0;
+  border: 0;
+  background: transparent;
+  border-radius: 11px;
+  padding: 11px 12px;
+  font-size: 14px;
+}
+.v3-home-main .v3-section-heading h2 {
+  font-size: 15px;
+  color: var(--v3-muted);
+  letter-spacing: 0;
+}
+.v3-next-name {
+  font-family: var(--ivory-display);
+  font-size: 32px !important;
+  font-weight: 500;
+}
+.v3-attention {
+  background: var(--v3-surface);
+  border-radius: 18px;
+}
+.v3-design-brief {
+  background: var(--v3-soft);
+  border: 0;
+  border-radius: 16px;
+}
+.v3-brief-toggle,
+.v3-thread-notes summary {
+  min-height: 44px;
+}
+/* Familiar chat geometry; the proposal remains part of the conversation. */
+.v3-thread-header h2 {
+  font-size: 18px;
+}
+.v3-messages {
+  gap: 16px;
+}
+.v3-message-text {
+  border-radius: 20px 20px 20px 6px;
+  font-size: 16px;
+  line-height: 1.45;
+  background: var(--v3-soft);
+}
+.v3-message.is-own .v3-message-text {
+  border-radius: 20px 20px 6px 20px;
+  background: var(--primary);
+  color: var(--primary-foreground);
+}
+.v3-composer {
+  border-top: 0;
+  padding: 10px 0;
+  align-items: center;
+}
+.v3-composer textarea {
+  border-radius: 24px;
+  padding: 13px 16px;
+  resize: none;
+}
+.v3-composer .v3-action {
+  border-radius: 50%;
+  min-width: 48px;
+}
+.v3-message time {
+  font-size: 12px;
+}
+/* Service colour carries meaning; selection never erases it. */
+.v3-day-strip button {
+  border-radius: 22px;
+  min-height: 70px;
+}
+.v3-day-strip button[aria-pressed="true"] {
+  background: var(--primary);
+  color: var(--primary-foreground);
+}
+.v3-day-strip button[aria-pressed="true"] span {
+  color: inherit;
+}
+.v3-day-strip strong {
+  font-weight: 500;
+  font-variant-numeric: tabular-nums;
+}
+.v3-calendar-event {
+  border-radius: 12px;
+}
+.v3-calendar-event.is-selected {
+  outline: 2px solid var(--v3-gold-ink);
+  outline-offset: -2px;
+}
+.v3-continuous-calendar {
+  border-color: var(--v3-line);
+  border-radius: 22px;
+}
+.v3-timeline-session {
+  border-radius: 15px;
+}
+.v3-timeline-day h3 {
+  font-weight: 550;
+}
+.v3-sitting-list > li {
+  border-radius: 15px;
+}
+/* System-like floating tab bar, retaining each role's existing destinations. */
+.v3-navigation {
+  inset: auto max(12px, var(--app-safe-right)) max(8px, var(--app-safe-bottom))
+    max(12px, var(--app-safe-left));
+  padding: 5px;
+  border: 1px solid color-mix(in srgb, var(--v3-line) 80%, transparent);
+  border-radius: 30px;
+  background: color-mix(in srgb, var(--v3-surface) 92%, transparent);
+  backdrop-filter: blur(22px);
+  -webkit-backdrop-filter: blur(22px);
+  box-shadow: 0 6px 25px rgb(56 44 36 / 10%);
+}
+.v3-navigation-items {
+  gap: 2px;
+  max-width: 600px;
+  margin: auto;
+}
+.v3-navigation-item {
+  min-height: 58px;
+  border-radius: 24px;
+  font-size: 11px;
+  gap: 3px;
+}
+.v3-navigation-item[aria-current="page"],
+.v3-navigation-artist .v3-navigation-item[aria-current="page"] {
+  background: var(--v3-soft);
+  color: var(--v3-ink);
+}
+.v3-navigation-item[aria-current="page"]::after {
+  display: none;
+}
+.v3-navigation-icon {
+  display: flex;
+}
+.v3-navigation-count {
+  background: var(--v3-red);
+  color: white;
+}

+/* Ivory: the shared Tattoi presentation layer. Domain and payment state stay in pages. */
+:root {
+  --ivory-display:
+    ui-serif, "Iowan Old Style", "Palatino Linotype", Georgia, serif;
+  --ivory-body:
+    -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
+  --ivory-warning: #855318;
+  --ivory-warning-bg: #f8eedc;
+  --ivory-shadow: 0 8px 28px rgb(56 44 36 / 5%);
+  --v3-radius: 22px;
+  --v3-gutter: 20px;
+  --color-primary: var(--primary);
+}
+.dark {
+  --ivory-warning: #e8c38c;
+  --ivory-warning-bg: #3a3021;
+  --ivory-shadow: 0 8px 28px rgb(0 0 0 / 12%);
+}
+body {
+  font-family: var(--ivory-body);
+  -webkit-font-smoothing: antialiased;
+}
+.v3-screen {
+  font-family: var(--ivory-body);
+  font-size: 17px;
+  line-height: 1.45;
+}
+.v3-header {
+  padding: 10px var(--v3-gutter) 22px;
+}
+.v3-masthead {
+  margin-bottom: 14px;
+}
+.v3-wordmark {
+  font: 32px/1 var(--ivory-display);
+  letter-spacing: -0.055em;
+  text-transform: none;
+}
+.v3-header h1 {
+  font-family: var(--ivory-display);
+  font-weight: 500;
+  font-size: 36px;
+  line-height: 1.1;
+  letter-spacing: -0.045em;
+}
+.v3-subtitle {
+  font-size: 15px;
+  line-height: 1.45;
+  margin-top: 8px;
+  max-width: 44ch;
+}
+.v3-content {
+  gap: 24px;
+  padding-bottom: 28px;
+}
+.v3-scroll {
+  scrollbar-width: thin;
+  scrollbar-color: var(--v3-line) transparent;
+}
+.v3-action {
+  border-radius: 16px;
+  min-height: 50px;
+  font-size: 16px;
+  font-weight: 550;
+  padding: 13px 18px;
+  transition:
+    background-color 0.15s,
+    transform 0.15s;
+}
+.v3-action-primary {
+  background: var(--primary);
+  color: var(--primary-foreground);
+  box-shadow: 0 2px 3px rgb(56 44 36 / 5%);
+}
+.v3-action-secondary {
+  background: var(--v3-soft);
+  border-color: transparent;
+}
+.v3-action-quiet {
+  box-shadow: none;
+}
+.v3-action:not(:disabled):active {
+  transform: scale(0.985);
+}
+.v3-icon-button {
+  border-radius: 50%;
+  background: var(--v3-soft);
+}
+.v3-section-heading {
+  margin: 0 2px 12px;
+}
+.v3-section-heading h2 {
+  font: 550 15px/1.35 var(--ivory-body);
+  text-transform: none;
+  letter-spacing: 0;
+  color: var(--v3-muted);
+}
+.v3-panel {
+  border-color: color-mix(in srgb, var(--v3-line) 60%, transparent);
+  box-shadow: var(--ivory-shadow);
+  padding: 20px;
+}
+.v3-panel h2,
+.v3-panel h3 {
+  font-weight: 550;
+  letter-spacing: -0.025em;
+}
+.v3-panel-attention {
+  background: var(--v3-gold-soft);
+}
+.v3-row {
+  padding: 16px 4px;

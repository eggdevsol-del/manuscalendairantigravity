+}
+.v3-row-copy strong {
+  font-weight: 550;
+  line-height: 1.35;
+}
+.v3-row-copy > span {
+  font-size: 14px;
+  line-height: 1.45;
+  margin-top: 4px;
+}
+.v3-row-icon {
+  color: var(--v3-gold-ink);
+}
+.v3-section > .v3-row {

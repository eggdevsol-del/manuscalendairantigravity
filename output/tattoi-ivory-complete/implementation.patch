+  padding: 15px 0;
+}
+.v3-price {
+  font: 40px/1.15 var(--ivory-display);
+  font-variant-numeric: tabular-nums;
+}
+/* A quiet next appointment leads the working day. Expand the task queue when needed. */
+.v3-home-main > .v3-stack {
+  order: -1;
+}
+.v3-home-tabs {
+  display: flex;
+  gap: 4px;
+  background: var(--v3-soft);
+  padding: 4px;
+  border-radius: 14px;
+}
+.v3-home-tabs a {
+  flex: 1;
+  min-width: 0;
+  border: 0;
+  background: transparent;
+  border-radius: 11px;
+  padding: 11px 12px;
+  font-size: 14px;
+}
+.v3-home-main .v3-section-heading h2 {
+  font-size: 15px;
+  color: var(--v3-muted);
+  letter-spacing: 0;
+}

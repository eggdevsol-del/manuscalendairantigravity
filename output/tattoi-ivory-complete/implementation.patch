+
+      advance(250);
+      frame();
+      expect(scroll.element.scrollTop).toBeGreaterThan(1000);
+      expect(scroll.element.scrollTop).toBeLessThan(
+        scroll.element.scrollHeight - 1000
+      );
+      expect(screen.getByLabelText("Selected calendar date")).toHaveTextContent(
